# Copy this file to .env and adjust values as needed.

# --- Database ---
POSTGRES_USER=scheduler_user
POSTGRES_PASSWORD=scheduler_pass
POSTGRES_DB=job_scheduler
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full SQLAlchemy connection string (used by the app itself).
# Note: host is "db" because that's the service name in docker-compose.
# If you run the backend outside Docker, change "db" to "localhost".
DATABASE_URL=postgresql+psycopg2://scheduler_user:scheduler_pass@db:5432/job_scheduler

# --- Auth (used starting Phase 2, defined now so config loads cleanly) ---
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
